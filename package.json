{
  "name": "routelinks",
  "displayName": "React Router Route Links — Remix & routes.ts",
  "description": "Clickable routes for React Router v7 and Remix. Ctrl+Click any routes.ts path or API route string in VS Code to jump straight to the file that handles it. Zero config, zero dependencies.",
  "version": "0.1.0",
  "publisher": "anparasan",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "react-router",
    "react router",
    "react-router-dom",
    "react-router-v7",
    "react router v7",
    "remix",
    "remix v2",
    "routes",
    "routes.ts",
    "route config",
    "routing",
    "file-based routing",
    "clickable routes",
    "clickable links",
    "ctrl+click",
    "go to definition",
    "document links",
    "navigation",
    "file navigation",
    "api routes",
    "typescript",
    "javascript",
    "tsx",
    "vscode",
    "vscode extension",
    "web development",
    "frontend"
  ],
  "markdown": "github",
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/anparasan.routelinks",
      "href": "https://marketplace.visualstudio.com/items?itemName=anparasan.routelinks",
      "description": "Installs"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/anparasan.routelinks",
      "href": "https://marketplace.visualstudio.com/items?itemName=anparasan.routelinks&ssr=false#review-details",
      "description": "Rating"
    }
  ],
  "galleryBanner": {
    "color": "#0b0d12",
    "theme": "dark"
  },
  "homepage": "https://routelinks.anpu.dev/",
  "bugs": {
    "url": "https://github.com/Anparasan3/route-links/issues"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "bun test",
    "release": "bun pm version",
    "release:preview": "bash scripts/release-preview.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.5.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "React Router Route Links",
      "properties": {
        "reactRouterRouteLinks.fileNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["routes.ts", "routes.js", "routes.tsx", "routes.jsx"],
          "description": "File names in which route path strings should become clickable links."
        },
        "reactRouterRouteLinks.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [".tsx", ".ts", ".jsx", ".js", ".mdx", ".md"],
          "description": "String literals ending with these extensions are treated as route file paths."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anparasan3/route-links"
  }
}
