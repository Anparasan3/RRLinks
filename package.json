{
  "name": "routelinks",
  "displayName": "React Router Route Links",
  "description": "Ctrl+Click route file paths and API route strings in React Router v7+ / Remix routes.ts configs to jump straight to the file that handles them",
  "version": "0.1.0",
  "publisher": "anparasan",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "react-router",
    "react-router-dom",
    "react-router-v7",
    "remix",
    "routes",
    "routing",
    "file-based routing",
    "go to definition",
    "document links",
    "navigation",
    "api routes",
    "typescript"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "homepage": "https://github.com/Anparasan3/route-links#readme",
  "bugs": {
    "url": "https://github.com/Anparasan3/route-links/issues"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "bun test",
    "release": "bun pm version",
    "release:preview": "bash scripts/release-preview.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.5.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "React Router Route Links",
      "properties": {
        "reactRouterRouteLinks.fileNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["routes.ts", "routes.js", "routes.tsx", "routes.jsx"],
          "description": "File names in which route path strings should become clickable links."
        },
        "reactRouterRouteLinks.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [".tsx", ".ts", ".jsx", ".js", ".mdx", ".md"],
          "description": "String literals ending with these extensions are treated as route file paths."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anparasan3/route-links"
  }
}
